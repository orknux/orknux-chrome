{
  "manifest_version": 3,
  "name": "Orknux",
  "description": "Lets your Orknux agents use this browser: open pages, read them, click and type - in a window of their own, while you watch.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Orknux"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "sidePanel"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
